<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An assembly that uses the mediator and caches nothing. Its whole purpose is
    to be handed to AddCQRS() in a test: the scan has to come up empty, and it
    only does that if no other type in the assembly implements a cache
    interface. That is why this is its own assembly and not a folder in the
    test project.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
  </ItemGroup>

</Project>
