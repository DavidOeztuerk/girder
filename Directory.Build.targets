<Project>

  <!--
    ADR-0001: Projekte mit NoeliaProviderFree=true dürfen keine
    Infrastrukturpakete referenzieren. Erlaubt sind nur Plattform-
    Abstraktionen (Microsoft.Extensions.*.Abstractions, Microsoft.Bcl.*,
    System.*) — alles, was eine Anbieterentscheidung enthält, gehört in ein
    Anbieterpaket.

    Der Guard steht hier und nicht in einer Prüfliste, weil eine Absicht
    keine drei Sprints hält: Wer unter Zeitdruck ein Paket hinzufügt, soll
    einen Übersetzungsfehler sehen, keine Codeprüfung abwarten müssen.
  -->
  <Target Name="NoeliaDependencyGuard"
          BeforeTargets="Build"
          Condition="'$(NoeliaProviderFree)' == 'true'">

    <ItemGroup>
      <NoeliaForbiddenPackage Include="@(PackageReference)"
        Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)',
          '^(Microsoft\.Extensions\.[A-Za-z0-9.]+\.Abstractions|Microsoft\.Bcl\.|System\.)'))" />
    </ItemGroup>

    <Error Condition="'@(NoeliaForbiddenPackage)' != ''"
           Code="NOELIA0001"
           Text="ADR-0001 verletzt: '$(MSBuildProjectName)' ist als anbieterfrei erklärt, referenziert aber @(NoeliaForbiddenPackage->'%(Identity)', ', '). Anbieterabhängigkeiten gehören in ein Noelia.&lt;Anbieter&gt;-Paket." />

    <!--
      Microsoft.NETCore.App fügt das SDK jedem Projekt implizit hinzu und ist
      die Laufzeit selbst; gemeint ist hier nur das Web-Framework.
    -->
    <ItemGroup>
      <NoeliaForbiddenFramework Include="@(FrameworkReference)"
        Condition="'%(Identity)' == 'Microsoft.AspNetCore.App'" />
    </ItemGroup>

    <Error Condition="'@(NoeliaForbiddenFramework)' != ''"
           Code="NOELIA0002"
           Text="ADR-0001 verletzt: '$(MSBuildProjectName)' ist als anbieterfrei erklärt, referenziert aber @(NoeliaForbiddenFramework->'%(Identity)', ', '). ASP.NET-Abhängigkeiten gehören nach Noelia.AspNetCore." />
  </Target>

</Project>
