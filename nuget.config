<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Girder's own packages. Reading from here needs a personal access token
      with read:packages — GitHub Packages has no anonymous access, which is
      why credentials live in the consumer's environment and never in this file.
    -->
    <add key="github" value="https://nuget.pkg.github.com/DavidOeztuerk/index.json" />
  </packageSources>

  <!--
    Which source may answer for which package. Without this, both sources are
    asked for every name, and whoever answers first wins — so anyone able to
    publish "Girder.Core" to nuget.org could have their package restored here
    instead of ours. Mapping closes that door: the Girder.* names are only ever
    resolved from the private feed.
  -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Girder.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
