<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Girder's own packages. Reading from here needs a personal access token
      with read:packages — GitHub Packages has no anonymous access, which is
      why credentials live in the consumer's environment and never in this file.
    -->
    <add key="github" value="https://nuget.pkg.github.com/DavidOeztuerk/index.json" />
  </packageSources>
</configuration>
