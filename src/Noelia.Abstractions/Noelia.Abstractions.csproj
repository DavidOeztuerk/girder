<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Noelia.Abstractions</PackageId>
    <Description>Every port Noelia exposes — token revocation, caching, rate limiting, secrets, encryption, audit, authorization, messaging. Providers implement these; no infrastructure dependency.</Description>
  </PropertyGroup>

  <!--
    Every port Noelia exposes. Providers implement these; the engine consumes
    them. Only platform abstractions may be referenced here, enforced by the
    NoeliaDependencyGuard target.
  -->

  <PropertyGroup>
    <NoeliaProviderFree>true</NoeliaProviderFree>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Noelia.Core/Noelia.Core.csproj" />
  </ItemGroup>

</Project>
