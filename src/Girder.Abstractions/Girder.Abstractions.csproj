<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every port Girder exposes. Providers implement these; the engine consumes
    them. Only platform abstractions may be referenced here, enforced by the
    GirderDependencyGuard target.
  -->

  <PropertyGroup>
    <GirderProviderFree>true</GirderProviderFree>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Girder.Core/Girder.Core.csproj" />
  </ItemGroup>

</Project>
