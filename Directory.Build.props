<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML comment) is suppressed: the summaries that matter are
      written, and requiring one on every member produces noise, not
      documentation. Everything else about the docs is an error, not a warning —
      a wrong cref or a half-documented signature reaches consumers as
      IntelliSense and misleads them there.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1587</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>David Öztürk</Authors>
    <Company>David Öztürk</Company>
    <Product>Girder</Product>
    <Copyright>Copyright © David Öztürk</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DavidOeztuerk/girder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DavidOeztuerk/girder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>microservices;cqrs;security;multi-tenancy;sovereignty</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>

    <!-- Ties a package back to the exact commit it was built from. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test projects are not packages. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
